# Application
NODE_ENV=development
PORT=5000
APP_NAME=Lumive Access
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173

# Database
DATABASE_URL=postgresql://username:password@localhost:5432/lumive_access
DB_HOST=localhost
DB_PORT=5432
DB_NAME=lumive_access
DB_USER=username
DB_PASSWORD=password

# Redis
REDIS_URL=redis://localhost:6379
REDIS_HOST=localhost
REDIS_PORT=6379

# JWT
JWT_SECRET=your-super-secret-jwt-key-change-this-in-production
JWT_REFRESH_SECRET=your-super-secret-refresh-key-change-this-in-production
JWT_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# Encryption
ENCRYPTION_KEY=your-32-byte-hex-encryption-key-change-this

# Beds24 API
BEDS24_CLIENT_ID=your-beds24-client-id
BEDS24_CLIENT_SECRET=your-beds24-client-secret
BEDS24_BASE_URL=https://api.beds24.com/v2

# Tuya Cloud API
TUYA_CLIENT_ID=your-tuya-client-id
TUYA_CLIENT_SECRET=your-tuya-client-secret
TUYA_BASE_URL=https://openapi.tuyaeu.com
TUYA_REGION=EU

# TTLock API
TTLOCK_CLIENT_ID=your-ttlock-client-id
TTLOCK_CLIENT_SECRET=your-ttlock-client-secret
TTLOCK_BASE_URL=https://euopen.ttlock.com
TTLOCK_REGION=EU

# Email Service (SendGrid)
SENDGRID_API_KEY=your-sendgrid-api-key
SENDGRID_FROM_EMAIL=noreply@lumiveaccess.com
SENDGRID_FROM_NAME=Lumive Access

# SMS Service (Twilio - Optional)
TWILIO_ACCOUNT_SID=your-twilio-account-sid
TWILIO_AUTH_TOKEN=your-twilio-auth-token
TWILIO_PHONE_NUMBER=+966500000000

# WhatsApp Business API (Optional)
WHATSAPP_API_KEY=your-whatsapp-api-key
WHATSAPP_PHONE_NUMBER=+966500000000

# Payment (Stripe)
STRIPE_SECRET_KEY=your-stripe-secret-key
STRIPE_PUBLISHABLE_KEY=your-stripe-publishable-key
STRIPE_WEBHOOK_SECRET=your-stripe-webhook-secret

# Monitoring (Sentry)
SENTRY_DSN=your-sentry-dsn

# Logging
LOG_LEVEL=info

# Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100

# i18n
DEFAULT_LANGUAGE=en
SUPPORTED_LANGUAGES=en,ar

# Timezone
DEFAULT_TIMEZONE=Asia/Riyadh

# File Upload
MAX_FILE_SIZE=5242880
UPLOAD_DIR=uploads

# Session
SESSION_SECRET=your-session-secret-change-this
